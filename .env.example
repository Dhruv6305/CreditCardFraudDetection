# Environment configuration example for Credit Card Fraud Detection
# Copy this file to .env to configure local environment variables.

# [Optional] Path to local creditcard.csv dataset file
# If not set, the pipeline attempts to download it via kagglehub ("mlg-ulb/creditcardfraud")
FRAUD_CSV=

# [Optional] Kaggle API Credentials (if required by your environment for kagglehub)
# KAGGLE_USERNAME=
# KAGGLE_KEY=
